# Credenciais do worker são injetadas pelo LiveKit Cloud.
# Para execução local, configure-as no ambiente sem commitar valores reais.
LIVEKIT_AGENT_NAME=ada-m-voice
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Backend ADA-M; use a URL HTTPS pública ou uma URL privada acessível ao worker.
ADA_M_API_URL=https://matheus-ai.onrender.com
ADA_M_APP_API_KEY=

# LiveKit Inference STT
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=pt-BR

# Não configure TTS neste worker. A voz feminina Tiny-Voca é servida pelo
# backend ADA-M através de /api/tts/speech; as credenciais ficam apenas na VPS.
