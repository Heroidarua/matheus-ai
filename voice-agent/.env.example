# LiveKit server credentials (never expose these in the browser)
LIVEKIT_AGENT_NAME=ada-m-voice
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Existing ADA-M backend
ADA_M_API_URL=https://matheus-ai.onrender.com
ADA_M_APP_API_KEY=

# OpenAI-compatible Kokoro endpoint. The service must expose /v1/audio/speech.
ADA_M_TTS_BASE_URL=https://your-kokoro-service.example/v1
ADA_M_TTS_API_KEY=
ADA_M_TTS_VOICE=pf_dora
ADA_M_TTS_SPEED=1.19

# LiveKit Inference STT
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=pt-BR
