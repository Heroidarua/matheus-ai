# Endpoint compatível com OpenAI. Ollama local: http://localhost:11434/v1
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen2.5:3b
OPENAI_API_KEY=ollama

# Pasta de documentos pessoais (.md/.txt) usada na recuperação RAG
KNOWLEDGE_DIR=data/knowledge

# Opcional: se preenchida, a API exige X-App-Key. Gere uma chave longa e aleatória.
APP_API_KEY=

# Opcional: habilita pesquisa na internet com fontes (Brave Search API)
BRAVE_SEARCH_API_KEY=

# GitHub App integration (configure as secrets in Render; never commit real values)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_SESSION_SECRET=
PUBLIC_APP_URL=https://SEU-SERVICO.onrender.com
COOKIE_HTTPS_ONLY=true
