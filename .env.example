# Endpoint compatível com OpenAI. Ollama local: http://localhost:11434/v1
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen2.5:3b
OPENAI_API_KEY=ollama

# Pasta de documentos pessoais (.md/.txt) usada na recuperação RAG
KNOWLEDGE_DIR=data/knowledge

# Opcional: se preenchida, a API exige X-App-Key. Gere uma chave longa e aleatória.
APP_API_KEY=

# Opcional: Google Search Grounding (Gemini pesquisa; o modelo principal continua respondendo)
GOOGLE_GEMINI_API_KEY=
GOOGLE_SEARCH_MODEL=gemini-2.5-flash

# Opcional: fallback de pesquisa na internet (Brave Search API)
BRAVE_SEARCH_API_KEY=

# Opcional: Google Workspace OAuth (somente leitura)
# Configure credenciais OAuth tipo Web Application no Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# URL PostgreSQL privada do serviço; tokens OAuth são armazenados criptografados.
DATABASE_URL=
# Chave Fernet, gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# GitHub App integration (configure as secrets in Render; never commit real values)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_SESSION_SECRET=
PUBLIC_APP_URL=https://SEU-SERVICO.onrender.com
COOKIE_HTTPS_ONLY=true

# Piper TTS remoto (serviço separado no Render)
# O backend lê TTS_API_URL (não TTS_API_BASE_URL) e a voz padrão é pf_dora.
TTS_API_URL=https://matheus-kokoro-tts.onrender.com/v1
TTS_API_KEY=
TTS_VOICE=pf_dora
